# ---------------------------------------------------------------------------
# CaptchaTunnel server configuration (loaded by the server, Docker Compose,
# and the systemd unit via EnvironmentFile).
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Tunnel authentication token. Generate with: deploy/scripts/generate-token.sh
# The client must present this token (or a proof of it) to open a tunnel.
CAPTCHATUNNEL_TOKEN=replace-with-a-long-random-secret

# Base domain used to build public URLs.
CAPTCHATUNNEL_BASE_DOMAIN=redy.captchamaster.org

# Public address reported in tcp:// URLs (IP or hostname of the VPS).
CAPTCHATUNNEL_PUBLIC_ADDR=redy.captchamaster.org

# Server bind addresses.
CAPTCHATUNNEL_CONTROL_ADDR=0.0.0.0:4443
CAPTCHATUNNEL_HTTP_ADDR=0.0.0.0:8080
CAPTCHATUNNEL_TCP_ADDR=0.0.0.0

# TCP tunnel port range assigned to clients.
CAPTCHATUNNEL_TCP_PORT_MIN=10000
CAPTCHATUNNEL_TCP_PORT_MAX=10100

# Control-channel TLS certificate/key (self-signed or CA-signed).
CAPTCHATUNNEL_TLS_CERT=/etc/captchatunnel/tls/server.crt
CAPTCHATUNNEL_TLS_KEY=/etc/captchatunnel/tls/server.key

# Heartbeat tuning.
CAPTCHATUNNEL_HEARTBEAT_INTERVAL=5s
CAPTCHATUNNEL_HEARTBEAT_TIMEOUT=15s
